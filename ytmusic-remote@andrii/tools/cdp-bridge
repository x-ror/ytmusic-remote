#!/usr/bin/env python3
"""cdp-bridge: start the YouTube Music app (pear-desktop) with its DevTools
protocol on a private pipe, and hand that pipe to the GNOME Shell extension
over a Unix socket that only this user can open.

Taken from nicolasfalesy/omarchy-youtube-music (MIT) and adapted for the
ytmusic-remote GNOME extension: the socket lives in
$XDG_RUNTIME_DIR/ytmusic-remote/, and the app path comes from $YTMR_APP when
the extension's settings name one (AppImage, a custom install).

Why a pipe: the extension needs the DevTools protocol to read the library,
search, the queue and the real play state. --remote-debugging-port would open
an unauthenticated TCP port that gives ANY local program full control of the
signed-in app, cookies included. Chromium's --remote-debugging-pipe speaks the
same protocol over two inherited file descriptors instead (the app reads
commands on fd 3 and writes answers on fd 4), so no port exists at all. This
program is the app's parent and the only holder of those pipes. It serves them
on the socket: the folder is 0700 and the socket 0600, and each connection's
peer uid is checked.

Framing: the pipe separates messages with a NUL byte; the socket uses a
newline, which JSON text never contains raw.

Usage: cdp-bridge [extra app arguments...]
       cdp-bridge --sign-in [extra app arguments...]

--sign-in starts the app WITHOUT the debugging pipe. Google refuses to sign
in to a browser that has remote debugging on ("This browser or app may not be
secure"), but it only checks while you sign in: the login cookie stays in the
app's profile, so after signing in once the app can be started through the
bridge again as usual. A bridged app that is already running is quit first,
because the app runs as a single instance.
"""

import json
import os
import select
import signal
import socket
import stat
import struct
import sys
import time

CANDIDATES = [
    "/opt/YouTube Music/youtube-music",
    "/opt/Pear Desktop/pear-desktop",
    "/usr/bin/youtube-music",
    "/usr/bin/pear-desktop",
    "/snap/bin/youtube-music",
]


def find_app():
    env = os.environ.get("YTMR_APP", "").strip()
    if env:
        return os.path.expanduser(env)
    for c in CANDIDATES:
        if os.access(c, os.X_OK):
            return c
    return CANDIDATES[0]


APP = find_app()
FLAGS_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                          "youtube-music-flags.conf")
MAX_PENDING = 256 * 1024 * 1024  # bytes without a separator before a peer is dropped
MAX_CLIENTS = 8


def die(msg, code=1):
    print("cdp-bridge: " + msg, file=sys.stderr)
    sys.exit(code)


def private_dir():
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    if not rt:
        die("XDG_RUNTIME_DIR is not set")
    st = os.lstat(rt)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        die("XDG_RUNTIME_DIR is not a private directory owned by this user")
    d = os.path.join(rt, "ytmusic-remote")
    try:
        os.mkdir(d, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        die(d + " is not a directory owned by this user")
    os.chmod(d, 0o700)
    return d


def app_argv(extra, pipe=True):
    flags = []
    try:
        with open(FLAGS_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                for word in line.split():
                    if word.startswith("--remote-debugging-"):
                        print("cdp-bridge: ignoring " + word + " from " + FLAGS_FILE
                              + " (the debugging channel is the private pipe)", file=sys.stderr)
                        continue
                    flags.append(word)
    except OSError:
        pass
    return [APP] + flags + (["--remote-debugging-pipe"] if pipe else []) + list(extra)


def sign_in(extra):
    # Quit a bridged copy first: a second start would only focus it, and the
    # sign-in would still happen with the pipe on.
    path = os.path.join(private_dir(), "cdp.sock")
    if os.path.exists(path):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(path)
            s.sendall(b'{"id":1,"method":"Browser.close","params":{}}\n')
            s.settimeout(1)
            # The bridge removes its socket once the app has gone.
            for _ in range(150):
                if not os.path.exists(path):
                    break
                time.sleep(0.1)
            else:
                die("the running YouTube Music did not quit; quit it and try again")
        except OSError:
            pass
        finally:
            s.close()
    argv = app_argv(extra, pipe=False)
    try:
        os.execve(argv[0], argv, dict(os.environ, ELECTRON_IS_DEV="0"))
    except OSError as e:
        die("cannot start " + argv[0] + ": " + str(e))


def write_all(fd, data):
    # os.write can write less than asked (a signal, a full pipe); a cut
    # message would corrupt every one after it.
    view = memoryview(data)
    while view:
        try:
            n = os.write(fd, view)
        except InterruptedError:
            continue
        view = view[n:]


def peer_uid(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", creds)[1]


def main():
    if sys.argv[1:2] == ["--sign-in"]:
        sign_in(sys.argv[2:])
    d = private_dir()
    path = os.path.join(d, "cdp.sock")

    # One bridge (so one app) at a time. A socket that answers means it runs.
    if os.path.exists(path):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(path)
            probe.close()
            return 0
        except OSError:
            os.unlink(path)

    to_app_r, to_app_w = os.pipe()        # app reads commands on fd 3
    from_app_r, from_app_w = os.pipe()    # app writes answers on fd 4
    argv = app_argv(sys.argv[1:])
    env = dict(os.environ, ELECTRON_IS_DEV="0")

    pid = os.fork()
    if pid == 0:
        try:
            # Park the pipe ends above 4 first so dup2 cannot clobber one with the other.
            a = os.dup(to_app_r)
            b = os.dup(from_app_w)
            os.dup2(a, 3)
            os.dup2(b, 4)
            devnull = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(devnull, fd)
            os.closerange(5, 1 << 16)
            os.set_inheritable(3, True)
            os.set_inheritable(4, True)
            os.execve(argv[0], argv, env)
        except Exception:
            os._exit(127)
    os.close(to_app_r)
    os.close(from_app_w)

    old_umask = os.umask(0o177)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    os.umask(old_umask)
    os.chmod(path, 0o600)
    server.listen(4)

    stopping = []
    # Never forward a TERM to the app: Chromium crashes on purpose on SIGTERM.
    # The widget quits it with Browser.close over this socket instead.
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    signal.signal(signal.SIGINT, lambda *_: stopping.append(1))
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)

    # Every connection is served at once. One copy of the widget runs per
    # monitor and each opens its own connection; when only the newest was
    # kept, the copies kicked each other off while the app started (each
    # polls the page for readiness), and the clicked copy's library load
    # failed with "not reachable" until the panel was reopened (2026-09-28).
    # Command ids are renumbered here so each answer goes back to the
    # connection that asked (every copy counts its ids from 1); events carry
    # no id and go to every connection.
    clients = {}  # socket -> bytes received without a newline yet
    sessions = {}  # socket -> page sessions it attached, detached when it drops
    attach_ids = {}  # bridge id of an attachToTarget -> the socket that asked
    routes = {}   # bridge id -> (socket, the id that connection used)
    next_id = 0
    nonlocal_next = [0]  # ids for the bridge's own commands (negative, never routed)
    from_app = b""

    def send_app(msg):
        write_all(to_app_w, json.dumps(msg, separators=(",", ":")).encode() + b"\0")

    def drop(conn):
        clients.pop(conn, None)
        # A client that goes away (the extension disabled, the screen locked)
        # must not leave its page session, and its binding pushes, behind.
        for sid in sessions.pop(conn, set()):
            nonlocal_next[0] += 1
            try:
                send_app({"id": -nonlocal_next[0], "method": "Target.detachFromTarget", "params": {"sessionId": sid}})
            except OSError:
                pass
        for rid in [rid for rid, (c, _) in routes.items() if c is conn]:
            del routes[rid]
        conn.close()

    try:
        while not stopping:
            done, _status = os.waitpid(pid, os.WNOHANG)
            if done:
                break
            watch = [server, from_app_r] + list(clients)
            try:
                ready, _, _ = select.select(watch, [], [], 1.0)
            except InterruptedError:
                continue
            if server in ready:
                conn, _ = server.accept()
                if peer_uid(conn) != os.getuid() or len(clients) >= MAX_CLIENTS:
                    conn.close()
                else:
                    # A client that stops reading is dropped after 5 s
                    # instead of stalling the others.
                    conn.settimeout(5)
                    clients[conn] = b""
            if from_app_r in ready:
                chunk = os.read(from_app_r, 1 << 20)
                if not chunk:
                    break  # the app closed its end: it is quitting
                from_app += chunk
                *messages, from_app = from_app.split(b"\0")
                if len(from_app) > MAX_PENDING:
                    from_app = b""
                out = {}  # socket -> lines to send
                for raw in messages:
                    try:
                        msg = json.loads(raw)
                    except ValueError:
                        continue
                    if isinstance(msg, dict) and "id" in msg:
                        asker = attach_ids.pop(msg["id"], None)
                        sid = (msg.get("result") or {}).get("sessionId") if isinstance(msg.get("result"), dict) else None
                        if asker is not None and sid and asker in clients:
                            sessions.setdefault(asker, set()).add(sid)
                        route = routes.pop(msg["id"], None)
                        if not route or route[0] not in clients:
                            continue
                        msg["id"] = route[1]
                        out.setdefault(route[0], []).append(json.dumps(msg, separators=(",", ":")).encode())
                    else:
                        for conn in clients:
                            out.setdefault(conn, []).append(raw)
                for conn, lines in out.items():
                    try:
                        conn.sendall(b"".join(line + b"\n" for line in lines))
                    except OSError:
                        drop(conn)
            for conn in [c for c in ready if c in clients]:
                try:
                    chunk = conn.recv(1 << 20)
                except OSError:
                    chunk = b""
                if not chunk:
                    drop(conn)
                    continue
                *lines, rest = (clients[conn] + chunk).split(b"\n")
                if len(rest) > MAX_PENDING:
                    drop(conn)
                    continue
                clients[conn] = rest
                for line in lines:
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if not isinstance(msg, dict):
                        continue
                    if "id" in msg:
                        next_id += 1
                        routes[next_id] = (conn, msg["id"])
                        msg["id"] = next_id
                        if msg.get("method") == "Target.attachToTarget":
                            attach_ids[next_id] = conn
                        if msg.get("method") == "Target.detachFromTarget":
                            sid = (msg.get("params") or {}).get("sessionId")
                            sessions.get(conn, set()).discard(sid)
                    send_app(msg)
        if stopping and not os.waitpid(pid, os.WNOHANG)[0]:
            # Stopped by a signal: quit the app too (Browser.close, never a
            # kill), or it would keep running with nobody able to reach it.
            try:
                send_app({"id": -1, "method": "Browser.close", "params": {}})
            except OSError:
                pass
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
        server.close()
        for conn in list(clients):
            conn.close()
        os.close(to_app_w)
        os.close(from_app_r)
    # Reap the app when it exits so it never lingers as a zombie.
    for _ in range(100):
        if os.waitpid(pid, os.WNOHANG)[0]:
            break
        time.sleep(0.1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
